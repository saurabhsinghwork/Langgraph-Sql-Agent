# Environment Configuration for LangGraph SQL Agent
# Copy this file to .env and configure your local credentials.
# NEVER commit your actual .env file with real secrets to version control.

# 1. Google Gemini Configuration
# Provide your Gemini API key (e.g. from Google AI Studio)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL_ID=gemini-2.0-flash-lite

# 2. Local MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=readonly_agent
MYSQL_PASSWORD=AgentSecurePassword123!

# 3. SQL Execution Security Bounds
SQL_CORRECTION_MAX_RETRIES=2
SQL_MAX_ROWS=50
SQL_QUERY_TIMEOUT_SECONDS=10

# 4. Optional Offline / SQLite Fallback
# When True, or when local MySQL is offline, connects to local SQLite database
USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH=ecommerce.db
